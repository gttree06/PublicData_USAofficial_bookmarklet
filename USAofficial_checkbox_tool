javascript:(function(){if(document.getElementById('bm-optout-panel')){document.getElementById('bm-optout-panel').remove();return;}function trigger(cb){cb.dispatchEvent(new Event('change',{bubbles:true}));cb.dispatchEvent(new Event('click',{bubbles:true}));}function getHeaders(){return Array.from(document.querySelectorAll('div,h2,h3,h4')).filter(function(el){var t=el.textContent.trim();return/matches found|matches for/i.test(t)&&t.length<100&&!el.querySelector('button');});}function getBoxesAfterHeader(header,addressFilter){var boxes=[];var el=header.parentElement;if(!el||!el.parentElement)return boxes;var siblings=Array.from(el.parentElement.children);var start=siblings.indexOf(el);for(var i=start+1;i<siblings.length;i++){var sib=siblings[i];if(/matches found|matches for/i.test(sib.textContent)&&sib.textContent.trim().length<100)break;var cbs=Array.from(sib.querySelectorAll('input[type="checkbox"]'));if(cbs.length){if(!addressFilter){cbs.forEach(function(cb){boxes.push(cb);});}else{cbs.forEach(function(cb){var el2=cb;var depth=0;var record=cb.parentElement;while(depth<6&&el2){if(el2.querySelectorAll('input[type="checkbox"]').length===1&&el2.textContent.length>20){record=el2;break;}el2=el2.parentElement;depth++;}if(record&&record.textContent.toLowerCase().indexOf(addressFilter.toLowerCase())!==-1){boxes.push(cb);}});}}}return boxes;}var headers=getHeaders().filter(function(el){return!/^0\s+(matches|match)/i.test(el.textContent.trim());});var panel=document.createElement('div');panel.id='bm-optout-panel';panel.style.cssText='position:fixed;top:20px;right:20px;z-index:999999;background:#1a1a2e;color:#e0e0ff;font-family:monospace;font-size:13px;padding:14px;border-radius:10px;box-shadow:0%204px%2030px%20rgba(0,0,0,0.6);min-width:290px;max-height:85vh;overflow-y:auto;border:1px%20solid%20#7c3aed;';var%20html='<div%20style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;"><strong%20style="color:#a78bfa;">&#9745;%20Opt-Out%20Helper</strong><button%20id="bm-x"%20style="background:none;border:none;color:#888;font-size:18px;cursor:pointer;line-height:1;">&times;</button></div>';html+='<div%20style="margin-bottom:10px;"><input%20id="bm-addr"%20type="text"%20placeholder="Filter%20by%20address..."%20style="width:100%;box-sizing:border-box;padding:7px%209px;background:#0f0f1a;color:#e0e0ff;border:1px%20solid%20#7c3aed;border-radius:6px;font-family:monospace;font-size:12px;outline:none;"/><div%20id="bm-match-count"%20style="font-size:10px;color:#888;margin-top:4px;min-height:14px;"></div></div>';html+='<button%20id="bm-addr-check"%20style="width:100%;padding:8px;background:#1d4ed8;color:#fff;border:none;border-radius:6px;cursor:pointer;font-weight:bold;font-size:13px;margin-bottom:6px;opacity:0.4;"%20disabled>Check%20Matching%20Address</button>';html+='<button%20id="bm-all"%20style="width:100%;padding:8px;background:#7c3aed;color:#fff;border:none;border-radius:6px;cursor:pointer;font-weight:bold;font-size:13px;margin-bottom:6px;">Check%20ALL</button>';html+='<button%20id="bm-none"%20style="width:100%;padding:8px;background:#374151;color:#ccc;border:none;border-radius:6px;cursor:pointer;font-size:12px;margin-bottom:14px;">Uncheck%20All</button>';html+='<div%20style="border-top:1px%20solid%20#333;padding-top:10px;"%20id="bm-secs"></div>';panel.innerHTML=html;document.body.appendChild(panel);var%20addrBtn=panel.querySelector('#bm-addr-check');function%20setChecked(cb,val){cb.checked=val;trigger(cb);}function%20buildSections(addressFilter){var%20secsDiv=panel.querySelector('#bm-secs');secsDiv.innerHTML='';var%20totalMatched=0;headers.forEach(function(header){var%20label=header.textContent.trim().replace(/\s+/g,'%20');var%20boxes=getBoxesAfterHeader(header,addressFilter);if(!boxes.length)return;totalMatched+=boxes.length;var%20checked=false;var%20row=document.createElement('div');row.style.cssText='display:flex;justify-content:space-between;align-items:center;padding:7px%200;border-bottom:1px%20solid%20#222;gap:10px;';var%20span=document.createElement('span');span.textContent=label;span.title=label;span.style.cssText='flex:1;color:#d1d5db;font-size:11px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;';var%20btn=document.createElement('button');btn.textContent='Check%20'+boxes.length;btn.style.cssText='background:#065f46;color:#6ee7b7;border:none;border-radius:4px;padding:4px%209px;cursor:pointer;font-size:11px;white-space:nowrap;flex-shrink:0;';btn.onclick=function(){if(!checked){boxes.forEach(function(cb){if(!cb.disabled)setChecked(cb,true);});btn.textContent='Uncheck%20'+boxes.length;btn.style.background='#7f1d1d';btn.style.color='#fca5a5';checked=true;}else{boxes.forEach(function(cb){if(!cb.disabled)setChecked(cb,false);});btn.textContent='Check%20'+boxes.length;btn.style.background='#065f46';btn.style.color='#6ee7b7';checked=false;}};row.appendChild(span);row.appendChild(btn);secsDiv.appendChild(row);});var%20countEl=panel.querySelector('#bm-match-count');if(addressFilter){countEl.textContent=totalMatched>0?totalMatched+'%20record(s)%20matching%20that%20address':'No%20records%20found%20with%20that%20address';countEl.style.color=totalMatched>0?'#6ee7b7':'#fca5a5';addrBtn.disabled=totalMatched===0;addrBtn.style.opacity=totalMatched===0?'0.4':'1';}else{countEl.textContent='';addrBtn.disabled=true;addrBtn.style.opacity='0.4';}}buildSections('');var%20allCount=document.querySelectorAll('input[type="checkbox"]').length;panel.querySelector('#bm-all').textContent='Check%20ALL%20('+allCount+'%20boxes)';var%20debounce;panel.querySelector('#bm-addr').oninput=function(){clearTimeout(debounce);var%20val=this.value.trim();debounce=setTimeout(function(){buildSections(val);},300);};addrBtn.onclick=function(){var%20addr=panel.querySelector('#bm-addr').value.trim();if(!addr)return;headers.forEach(function(header){getBoxesAfterHeader(header,addr).forEach(function(cb){if(!cb.disabled)setChecked(cb,true);});});buildSections(addr);};panel.querySelector('#bm-all').onclick=function(